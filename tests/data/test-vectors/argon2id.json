      "password": "test123",
      "salt_hex": "4b376d5839704c32715238764e34775a",
      "expected_key_hex": "de3bfc39034371d589b34d485c572c12ce2ac6d4464adaea47fc1fb1e0fbfbd3"
    },
    {
      "id": "argon2id-03-complex-password",
